{
  "_comment": "Gemeinsame Testfälle für die strenge Prüfung einer .reg-Sicherung: Modul (Test-RegistryBackupContent) und Helfer (RegistryBackupRules.CheckContent) müssen beide dieselben Ergebnisse liefern. Platzhalter: {H} = Kopfzeile, {U} = HKCU-Uninstall-Zweig, {M} = HKLM-Uninstall-Zweig, {M32} = HKLM-WOW6432Node-Zweig (jeweils nativer Pfad). scope = erlaubter Bereich; key = Hauptschlüssel aus der Begleitdatei; expected = null (passt) oder der Grund-Code.",
  "header": "Windows Registry Editor Version 5.00",
  "locations": [
    { "nativePath": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall", "scope": "Machine", "placeholder": "{M}" },
    { "nativePath": "HKEY_LOCAL_MACHINE\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall", "scope": "Machine", "placeholder": "{M32}" },
    { "nativePath": "HKEY_CURRENT_USER\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall", "scope": "User", "placeholder": "{U}" }
  ],
  "cases": [
    { "name": "ein Hauptschlüssel (HKCU)", "scope": "User", "key": "{U}\\App", "text": "{H}\r\n\r\n[{U}\\App]\r\n\"DisplayName\"=\"x\"\r\n", "expected": null },
    { "name": "Unterschlüssel, auch tief", "scope": "User", "key": "{U}\\App", "text": "{H}\r\n\r\n[{U}\\App]\r\n\r\n[{U}\\App\\Sub]\r\n\r\n[{U}\\App\\Sub\\Deep]\r\n", "expected": null },
    { "name": "Groß-/Kleinschreibung egal", "scope": "User", "key": "{U}\\App", "text": "{H}\r\n\r\n[{U}\\APP]\r\n", "expected": null },
    { "name": "Hauptschlüssel unter HKLM", "scope": "Machine", "key": "{M}\\App", "text": "{H}\r\n\r\n[{M}\\App]\r\n\"DisplayName\"=\"x\"\r\n", "expected": null },
    { "name": "Hauptschlüssel unter HKLM WOW6432Node", "scope": "Machine", "key": "{M32}\\App", "text": "{H}\r\n\r\n[{M32}\\App]\r\n\r\n[{M32}\\App\\Sub]\r\n", "expected": null },
    { "name": "HKLM-Schlüssel, aber nur Benutzer erlaubt", "scope": "User", "key": "{M}\\App", "text": "{H}\r\n\r\n[{M}\\App]\r\n", "expected": "MachineNotYet" },
    { "name": "HKCU-Schlüssel, aber nur HKLM erlaubt", "scope": "Machine", "key": "{U}\\App", "text": "{H}\r\n\r\n[{U}\\App]\r\n", "expected": "WrongScope" },
    { "name": "Präfix-Trick: AppX ist kein Unterschlüssel von App", "scope": "User", "key": "{U}\\App", "text": "{H}\r\n\r\n[{U}\\App]\r\n\r\n[{U}\\AppX]\r\n", "expected": "KeyOutside" },
    { "name": "Präfix-Trick bei HKLM", "scope": "Machine", "key": "{M}\\App", "text": "{H}\r\n\r\n[{M}\\App]\r\n\r\n[{M}\\App2]\r\n", "expected": "KeyOutside" },
    { "name": "fremder Schlüssel daneben", "scope": "User", "key": "{U}\\App", "text": "{H}\r\n\r\n[{U}\\App]\r\n\r\n[HKEY_CURRENT_USER\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run]\r\n", "expected": "KeyOutside" },
    { "name": "HKCU-Unterschlüssel in einer HKLM-Sicherung", "scope": "Machine", "key": "{M}\\App", "text": "{H}\r\n\r\n[{M}\\App]\r\n\r\n[{U}\\App\\Sub]\r\n", "expected": "KeyOutside" },
    { "name": "Hauptschlüssel zweimal", "scope": "User", "key": "{U}\\App", "text": "{H}\r\n\r\n[{U}\\App]\r\n\r\n[{U}\\App]\r\n", "expected": "KeyOutside" },
    { "name": "anderer Schlüssel zuerst", "scope": "User", "key": "{U}\\App", "text": "{H}\r\n\r\n[{U}\\Other]\r\n\r\n[{U}\\App]\r\n", "expected": "KeyMismatch" },
    { "name": "Hauptschlüssel außerhalb der Uninstall-Zweige", "scope": "User", "key": "HKEY_CURRENT_USER\\SOFTWARE\\Other\\App", "text": "{H}\r\n\r\n[HKEY_CURRENT_USER\\SOFTWARE\\Other\\App]\r\n", "expected": "KeyNotUninstall" },
    { "name": "Hauptschlüssel eine Ebene zu tief", "scope": "User", "key": "{U}\\App\\Sub", "text": "{H}\r\n\r\n[{U}\\App\\Sub]\r\n", "expected": "KeyNotUninstall" },
    { "name": "Hauptschlüssel ist der Zweig selbst", "scope": "User", "key": "{U}", "text": "{H}\r\n\r\n[{U}]\r\n", "expected": "KeyNotUninstall" },
    { "name": "Löschzeile", "scope": "User", "key": "{U}\\App", "text": "{H}\r\n\r\n[{U}\\App]\r\n\r\n[-{U}\\Other]\r\n", "expected": "DeleteLine" },
    { "name": "Löschzeile mit Leerzeichen davor", "scope": "User", "key": "{U}\\App", "text": "{H}\r\n\r\n[{U}\\App]\r\n  [-{U}\\Other]\r\n", "expected": "DeleteLine" },
    { "name": "Löschzeile bei HKLM", "scope": "Machine", "key": "{M}\\App", "text": "{H}\r\n\r\n[{M}\\App]\r\n\r\n[-{M}\\Other]\r\n", "expected": "DeleteLine" },
    { "name": "falscher Kopf", "scope": "User", "key": "{U}\\App", "text": "REGEDIT4\r\n\r\n[{U}\\App]\r\n", "expected": "BadHeader" },
    { "name": "kein Schlüsselkopf", "scope": "User", "key": "{U}\\App", "text": "{H}\r\n\r\n\"A\"=\"1\"\r\n", "expected": "KeyNotFound" },
    { "name": "kaputte Schlüsselzeile", "scope": "User", "key": "{U}\\App", "text": "{H}\r\n\r\n[{U}\\App", "expected": "BadKeyLine" },
    { "name": "leerer Text", "scope": "User", "key": "{U}\\App", "text": "", "expected": "Empty" },
    { "name": "versteckte Schlüsselzeile nach einzelnem CR", "scope": "User", "key": "{U}\\App", "text": "{H}\r\n\r\n[{U}\\App]\r\r[HKEY_CURRENT_USER\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run]\r\n", "expected": "BadLineBreak" },
    { "name": "versteckte Schlüsselzeile nach einzelnem LF", "scope": "User", "key": "{U}\\App", "text": "{H}\r\n\r\n[{U}\\App]\n[HKEY_CURRENT_USER\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run]\r\n", "expected": "BadLineBreak" },
    { "name": "NUL im Text", "scope": "User", "key": "{U}\\App", "text": "{H}\r\n\r\n[{U}\\App]\u0000[HKEY_CURRENT_USER\\Run]\r\n", "expected": "BadLineBreak" },
    { "name": "Zeilentrenner U+2028", "scope": "User", "key": "{U}\\App", "text": "{H}\r\n\r\n[{U}\\App] [HKEY_CURRENT_USER\\Run]\r\n", "expected": "BadLineBreak" },
    { "name": "Zeilentrenner U+2029", "scope": "User", "key": "{U}\\App", "text": "{H}\r\n\r\n[{U}\\App] [HKEY_CURRENT_USER\\Run]\r\n", "expected": "BadLineBreak" },
    { "name": "Zeilentrenner U+0085", "scope": "User", "key": "{U}\\App", "text": "{H}\r\n\r\n[{U}\\App]\u0085[HKEY_CURRENT_USER\\Run]\r\n", "expected": "BadLineBreak" },
    { "name": "Vertikaltabulator", "scope": "User", "key": "{U}\\App", "text": "{H}\r\n\r\n[{U}\\App]\u000b[HKEY_CURRENT_USER\\Run]\r\n", "expected": "BadLineBreak" },
    { "name": "Seitenvorschub", "scope": "User", "key": "{U}\\App", "text": "{H}\r\n\r\n[{U}\\App]\u000c[HKEY_CURRENT_USER\\Run]\r\n", "expected": "BadLineBreak" }
  ]
}
