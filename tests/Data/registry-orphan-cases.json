{
  "_comment": "Gemeinsame Testfälle für die Verwaist-Prüfung eines Uninstall-Eintrags: Modul (Test-OrphanedRegistryEntry) und Helfer (OrphanRules.Check) müssen beide dasselbe Ergebnis liefern. Platzhalter in Texten: {PF} = Programme-Ordner, {SYS} = System32, {WIN} = Windows-Ordner, {ROOT} = Wurzel des Programme-Ordners (z. B. C:\\), {U+XXXX} = das Zeichen mit diesem Codepunkt. Eingaben: msi, uninstall, quiet, location, icon (rohe Registry-Werte); files/dirs = vorhandene Dateien/Ordner; drives = bekannte Laufwerkswurzeln mit ihrer Art (Standard: nur {ROOT} als Fixed); ein Laufwerk, das nicht in drives steht, ist nicht erreichbar. orphaned = erwartetes Ergebnis.",
  "cases": [
    { "name": "Befehl mit Anführungszeichen fehlt", "uninstall": "\"{PF}\\Gone\\unins.exe\" /S", "orphaned": true },
    { "name": "Befehl ohne Anführungszeichen fehlt", "uninstall": "{PF}\\Gone\\unins.exe /S", "orphaned": true },
    { "name": "Ordner mit Leerzeichen, ohne Anführungszeichen", "uninstall": "{PF}\\My App\\unins.exe /S", "orphaned": true },
    { "name": "MSI-Eintrag ist nie verwaist", "msi": true, "uninstall": "\"{PF}\\Gone\\unins.exe\"", "orphaned": false },
    { "name": "ohne UninstallString, nur QuietUninstallString (fehlt)", "quiet": "\"{PF}\\Gone\\quiet.exe\" /S", "orphaned": false },
    { "name": "ohne jeden Befehl", "orphaned": false },
    { "name": "UninstallString nur Leerraum", "uninstall": "   ", "orphaned": false },
    { "name": "Datei im Befehl vorhanden", "uninstall": "\"{PF}\\Present\\unins.exe\" /S", "files": ["{PF}\\Present\\unins.exe"], "orphaned": false },
    { "name": "Pfad im Befehl ist ein vorhandener Ordner", "uninstall": "\"{PF}\\Dir.exe\"", "dirs": ["{PF}\\Dir.exe"], "orphaned": false },
    { "name": "rundll32 ohne Pfad (System32)", "uninstall": "rundll32.exe shell32.dll,Control_RunDLL x", "orphaned": false },
    { "name": "msiexec ohne Pfad", "uninstall": "MsiExec.exe /X{11111111-2222-3333-4444-555555555555}", "orphaned": false },
    { "name": "Befehl ohne Pfad wird in System32 gesucht", "uninstall": "uninst.exe /S", "orphaned": false },
    { "name": "Pfad unter dem Windows-Ordner fehlt, ist aber nie verwaist", "uninstall": "\"{WIN}\\Installer\\x.exe\"", "orphaned": false },
    { "name": "kein .exe im Befehl", "uninstall": "setup /x", "orphaned": false },
    { "name": "Anführungszeichen nicht geschlossen", "uninstall": "\"{PF}\\x\\unins.exe /S", "orphaned": false },
    { "name": "leere Anführungszeichen", "uninstall": "\"\"", "orphaned": false },
    { "name": "QuietUninstallString fehlt ebenfalls", "uninstall": "\"{PF}\\Gone\\unins.exe\"", "quiet": "\"{PF}\\Gone\\quiet.exe\" /S", "orphaned": true },
    { "name": "QuietUninstallString vorhanden", "uninstall": "\"{PF}\\Gone\\unins.exe\"", "quiet": "\"{PF}\\Present\\quiet.exe\" /S", "files": ["{PF}\\Present\\quiet.exe"], "orphaned": false },
    { "name": "QuietUninstallString ist ein Systemwerkzeug", "uninstall": "\"{PF}\\Gone\\unins.exe\"", "quiet": "msiexec.exe /x {X} /qn", "orphaned": false },
    { "name": "InstallLocation vorhanden", "uninstall": "\"{PF}\\Gone\\unins.exe\"", "location": "{PF}\\Present", "dirs": ["{PF}\\Present"], "orphaned": false },
    { "name": "InstallLocation fehlt auch", "uninstall": "\"{PF}\\Gone\\unins.exe\"", "location": "{PF}\\GoneDir", "orphaned": true },
    { "name": "InstallLocation nur Leerraum wird übersprungen", "uninstall": "\"{PF}\\Gone\\unins.exe\"", "location": "  ", "orphaned": true },
    { "name": "DisplayIcon vorhanden", "uninstall": "\"{PF}\\Gone\\unins.exe\"", "icon": "{PF}\\Present\\a.ico", "files": ["{PF}\\Present\\a.ico"], "orphaned": false },
    { "name": "DisplayIcon fehlt auch", "uninstall": "\"{PF}\\Gone\\unins.exe\"", "icon": "{PF}\\Gone\\a.ico", "orphaned": true },
    { "name": "DisplayIcon mit Index fehlt", "uninstall": "\"{PF}\\Gone\\unins.exe\"", "icon": "\"{PF}\\Gone\\app.exe\",0", "orphaned": true },
    { "name": "DisplayIcon mit negativem Index fehlt", "uninstall": "\"{PF}\\Gone\\unins.exe\"", "icon": "{PF}\\Gone\\app.exe, -5", "orphaned": true },
    { "name": "DisplayIcon mit Index vorhanden", "uninstall": "\"{PF}\\Gone\\unins.exe\"", "icon": "\"{PF}\\Present\\app.exe\",2", "files": ["{PF}\\Present\\app.exe"], "orphaned": false },
    { "name": "Netzwerkpfad (UNC)", "uninstall": "\\\\server\\share\\unins.exe /S", "orphaned": false },
    { "name": "relativer Pfad in Anführungszeichen", "uninstall": "\"unins.exe\"", "orphaned": false },
    { "name": "Laufwerk nicht erreichbar", "uninstall": "Z:\\App\\unins.exe /S", "orphaned": false },
    { "name": "Netzlaufwerk mit Buchstabe", "uninstall": "Q:\\App\\unins.exe /S", "drives": { "{ROOT}": "Fixed", "Q:\\": "Network" }, "orphaned": false },
    { "name": "USB-Stick (Removable)", "uninstall": "R:\\App\\unins.exe /S", "drives": { "{ROOT}": "Fixed", "R:\\": "Removable" }, "orphaned": false },
    { "name": "CD-Laufwerk", "uninstall": "S:\\App\\unins.exe /S", "drives": { "{ROOT}": "Fixed", "S:\\": "CDRom" }, "orphaned": false },
    { "name": "zweites festes Laufwerk, Datei fehlt", "uninstall": "D:\\Apps\\unins.exe /S", "drives": { "{ROOT}": "Fixed", "D:\\": "Fixed" }, "orphaned": true },
    { "name": "Laufwerksart unbekannt", "uninstall": "T:\\App\\unins.exe /S", "drives": { "{ROOT}": "Fixed", "T:\\": "NoRootDirectory" }, "orphaned": false },
    { "name": "Umgebungsvariable im Befehl", "uninstall": "\"%ProgramFiles%\\Gone\\unins.exe\" /S", "orphaned": true },
    { "name": "unbekannte Umgebungsvariable", "uninstall": "%SWV_GIBT_ES_NICHT%\\x.exe /S", "orphaned": false },
    { "name": "Umgebungsvariable im DisplayIcon", "uninstall": "\"{PF}\\Gone\\unins.exe\"", "icon": "%ProgramFiles%\\Gone\\a.ico", "orphaned": true },
    { "name": "Jan-Fall: Ordner der neuen Installation existiert in anderer Schreibweise", "uninstall": "\"{PF}\\Programs\\jan\\Uninstall Jan.exe\" /currentuser", "icon": "{PF}\\Programs\\jan\\uninstallerIcon.ico", "dirs": ["{PF}\\Programs\\Jan"], "orphaned": true },
    { "name": "zwei .exe-Kandidaten, der längere existiert", "uninstall": "{PF}\\Tool.exe --x.exe", "files": ["{PF}\\Tool.exe --x.exe"], "orphaned": false },
    { "name": "zwei .exe-Kandidaten, keiner existiert", "uninstall": "{PF}\\Tool.exe --x.exe", "orphaned": true },
    { "name": "Zeichen mit Codepunkt im Pfad bleibt auswertbar", "uninstall": "\"{PF}\\Gon{U+00E9}\\unins.exe\"", "orphaned": true }
  ]
}
