<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dieselben Regel-Tests wie in Softwareverwaltung.App.Tests, aber unter .NET Framework 4.7.2, wie der Helfer wirklich
    läuft (Path-Ausnahmen, Zugriffsrechte über FileStream, lange Pfade verhalten sich dort anders als unter .NET 10).
    Die Testdateien sind verlinkt, nicht kopiert. System.Text.Json nur hier: .NET Framework bringt es nicht mit, die
    gemeinsamen Fälletabellen (tests/Data/*.json) werden damit gelesen.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Softwareverwaltung.App.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="System.Text.Json" Version="10.0.0" />
    <Reference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\SoftwareInventory.Helper\HelperRules.cs" Link="Helper\HelperRules.cs" />
    <Compile Include="..\..\src\SoftwareInventory.Helper\HelperCopyRules.cs" Link="Helper\HelperCopyRules.cs" />
    <Compile Include="..\..\src\SoftwareInventory.Helper\RegistryBackupRules.cs" Link="Helper\RegistryBackupRules.cs" />
    <Compile Include="..\..\src\SoftwareInventory.Helper\BackupFolderRules.cs" Link="Helper\BackupFolderRules.cs" />
    <Compile Include="..\..\src\SoftwareInventory.Helper\WindowsDirectoryInspector.cs" Link="Helper\WindowsDirectoryInspector.cs" />
    <Compile Include="..\..\src\SoftwareInventory.Helper\BackupFileRules.cs" Link="Helper\BackupFileRules.cs" />
    <Compile Include="..\..\src\SoftwareInventory.Helper\WindowsBackupFileReader.cs" Link="Helper\WindowsBackupFileReader.cs" />
    <Compile Include="..\..\src\SoftwareInventory.Helper\OrphanRules.cs" Link="Helper\OrphanRules.cs" />
    <Compile Include="..\..\src\SoftwareInventory.Helper\WindowsOrphanEnvironment.cs" Link="Helper\WindowsOrphanEnvironment.cs" />
    <Compile Include="..\..\src\SoftwareInventory.Helper\RegistryRemoval.cs" Link="Helper\RegistryRemoval.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Softwareverwaltung.App.Tests\OrphanRulesTests.cs" Link="Shared\OrphanRulesTests.cs" />
    <Compile Include="..\Softwareverwaltung.App.Tests\RegistryBackupRulesTests.cs" Link="Shared\RegistryBackupRulesTests.cs" />
    <Compile Include="..\Softwareverwaltung.App.Tests\BackupFileRulesTests.cs" Link="Shared\BackupFileRulesTests.cs" />
    <Compile Include="..\Softwareverwaltung.App.Tests\BackupFolderRulesTests.cs" Link="Shared\BackupFolderRulesTests.cs" />
    <Compile Include="..\Softwareverwaltung.App.Tests\AclRulesTests.cs" Link="Shared\AclRulesTests.cs" />
    <Compile Include="..\Softwareverwaltung.App.Tests\OperationRulesTests.cs" Link="Shared\OperationRulesTests.cs" />
    <Compile Include="..\Softwareverwaltung.App.Tests\HelperCopyRulesTests.cs" Link="Shared\HelperCopyRulesTests.cs" />
    <Compile Include="..\Softwareverwaltung.App.Tests\RegistryRemovalTests.cs" Link="Shared\RegistryRemovalTests.cs" />
    <Compile Include="..\Softwareverwaltung.App.Tests\MachineFoldersTests.cs" Link="Shared\MachineFoldersTests.cs" />
  </ItemGroup>

</Project>
