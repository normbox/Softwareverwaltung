<UserControl x:Class="Softwareverwaltung.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Softwareverwaltung.App.ViewModels"
             xmlns:loc="clr-namespace:Softwareverwaltung.App.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,20,0,4" />
        </Style>
        <Style x:Key="SubsectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="SectionText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>

        <!-- Ein Schalter als Karte: Beschriftung links, Schalter rechts. -->
        <DataTemplate x:Key="SwitchCard" DataType="{x:Type vm:SettingSwitch}">
            <ui:CardControl Margin="0,0,0,4" Padding="14,10">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding IsOn}" AutomationProperties.Name="{Binding Label}"
                                 OnContent="An" OffContent="Aus" />
            </ui:CardControl>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding IsLoaded}">
            <StackPanel Margin="16,0,16,16" MaxWidth="880" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource SectionText}" Margin="0,12,0,0"
                           Text="Alles ist anfangs aus. Schalten Sie nur ein, was Sie brauchen. Änderungen gelten nach „Speichern“ und dem nächsten Scan." />

                <!-- Nutzung -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Nutzung" />
                <TextBlock Style="{StaticResource SectionText}"
                           Text="Bestimmt nur, welche Hinweise zu den Nutzungsbedingungen angezeigt werden. Schaltet nichts ein oder aus." />
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Privat" GroupName="Usage" IsChecked="{Binding IsPrivate}" />
                    <RadioButton Content="Firma" GroupName="Usage" Margin="16,0,0,0" IsChecked="{Binding IsCompany}" />
                </StackPanel>
                <Expander Header="Hinweise zu den Nutzungsbedingungen der Dienste" Margin="0,8,0,0"
                          Visibility="{Binding Usage, Converter={StaticResource NullToVisibility}}">
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="{Binding TermsGeneral}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding ServiceTerms}" ItemTemplate="{StaticResource ServiceTermsTemplate}" />
                    </StackPanel>
                </Expander>

                <!-- Vorlagen -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Vorlagen" />
                <TextBlock Style="{StaticResource SectionText}" Text="{loc:Text PresetsText}" />
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="{loc:Text PresetQuick}" Icon="{ui:SymbolIcon Flash24}"
                               Command="{Binding ApplyPresetCommand}" CommandParameter="Quick"
                               ToolTip="{loc:Text PresetQuickTooltip}" />
                    <ui:Button Content="{loc:Text PresetThorough}" Icon="{ui:SymbolIcon Search24}" Margin="8,0,0,0"
                               Command="{Binding ApplyPresetCommand}" CommandParameter="Thorough"
                               ToolTip="{loc:Text PresetThoroughTooltip}" />
                </StackPanel>

                <!-- Quellen -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Installierte Programme" />
                <TextBlock Style="{StaticResource SectionText}" Text="Woher die Liste der installierten Programme kommt. Alles bleibt auf diesem PC." />
                <ItemsControl ItemsSource="{Binding Sources}" ItemTemplate="{StaticResource SwitchCard}" />

                <!-- Suche nach portablen Programmen: Hauptschalter, dann „Wo suchen“, dann „Wie suchen“ -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Text SettingsPortableTitle}" />

                <ui:CardControl Margin="0,4,0,4" Padding="14,10">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{loc:Text SettingsPortableSwitchLabel}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Text SettingsPortableIntro}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding PortableSearchEnabled}" AutomationProperties.Name="{loc:Text SettingsPortableSwitchLabel}"
                                     OnContent="{loc:Text SwitchOn}" OffContent="{loc:Text SwitchOff}" />
                </ui:CardControl>

                <!-- Erst aktiv, wenn der Hauptschalter an ist; vorher ausgegraut -->
                <StackPanel IsEnabled="{Binding PortableSearchEnabled}">
                    <TextBlock Style="{StaticResource SubsectionTitle}" Text="{loc:Text SettingsPortableWhereTitle}" />
                    <TextBlock Style="{StaticResource SectionText}" Text="{loc:Text SettingsPortableWhereText}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text SettingsPortableDrives}" />
                    <ItemsControl ItemsSource="{Binding Drives}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DriveOption}">
                                <CheckBox Content="{Binding Text}" IsChecked="{Binding IsSelected}" Margin="0,0,16,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text SettingsPortableFolders}" />
                    <ui:TextBox Text="{Binding ScanPathsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                MinHeight="64" TextWrapping="NoWrap" AutomationProperties.Name="{loc:Text SettingsPortableFolders}" />

                    <!-- Ohne Laufwerk und Ordner wird nichts durchsucht -->
                    <Border Margin="0,8,0,0" Padding="12,10" CornerRadius="4" BorderThickness="1"
                            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Visibility="{Binding NoScanLocation, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Warning24" Filled="True" Margin="0,0,10,0" VerticalAlignment="Top"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="{loc:Text SettingsPortableNoLocation}" TextWrapping="Wrap" MaxWidth="800" />
                        </StackPanel>
                    </Border>

                    <!-- Hinweis zwischen den Unterabschnitten -->
                    <Border Margin="0,8,0,0" Padding="12,10" CornerRadius="4" BorderThickness="1"
                            Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Info24" Filled="True" Margin="0,0,10,0" VerticalAlignment="Top"
                                           Foreground="{DynamicResource SystemFillColorAttentionBrush}" />
                            <TextBlock Text="{loc:Text SettingsPortableInstalledHint}" TextWrapping="Wrap" MaxWidth="800" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SubsectionTitle}" Text="{loc:Text SettingsPortableHowTitle}" />
                    <TextBlock Style="{StaticResource SectionText}" Text="{loc:Text SettingsPortableHowText}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text SettingsPortableTraces}" />
                    <ItemsControl ItemsSource="{Binding Traces}" ItemTemplate="{StaticResource SwitchCard}" />
                    <CheckBox Content="{loc:Text SettingsPortableIncludeTemp}" IsChecked="{Binding IncludeTemp}" Margin="0,8,0,0" />
                    <CheckBox Content="{loc:Text SettingsPortableComputeHash}" IsChecked="{Binding ComputeHash}" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text SettingsPortableExcludes}" />
                    <ui:TextBox Text="{Binding ExcludePathsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                MinHeight="64" TextWrapping="NoWrap" AutomationProperties.Name="{loc:Text SettingsPortableExcludes}" />
                    <CheckBox IsChecked="{Binding SmartExclusions}" Margin="0,8,0,0">
                        <TextBlock TextWrapping="Wrap" Text="{loc:Text SettingsPortableSmartExclusions}" />
                    </CheckBox>
                </StackPanel>

                <!-- Externe Dienste -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Externe Dienste" />
                <TextBlock Style="{StaticResource SectionText}"
                           Text="Diese Dienste senden Daten ins Internet. Jeder Eintrag sagt, was übertragen wird. Ohne sie bleibt die Ampel grau („nicht geprüft“)." />
                <ItemsControl ItemsSource="{Binding Services}" ItemTemplate="{StaticResource SwitchCard}" />

                <!-- API-Schlüssel -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="API-Schlüssel" />
                <TextBlock Style="{StaticResource SectionText}"
                           Text="Werden in der Windows-Anmeldeinformationsverwaltung gespeichert, nur für Ihr Benutzerkonto. Sie werden sofort gespeichert und nie angezeigt." />
                <ItemsControl ItemsSource="{Binding Credentials}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CredentialItem}">
                            <ui:Card Margin="0,0,0,4" Padding="14,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <PasswordBox x:Name="Secret" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                                                 AutomationProperties.Name="{Binding Title}" />
                                    <ui:Button Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Content="Speichern" Click="OnSaveCredential" Tag="{Binding ElementName=Secret}" />
                                    <ui:Button Grid.Row="0" Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Content="Löschen" IsEnabled="{Binding Stored}"
                                               Command="{Binding DataContext.RemoveCredentialCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,6,0,0"
                                               Text="{Binding StatusText}" TextWrapping="Wrap" />
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Aktionen -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Aktualisieren und Deinstallieren" />
                <ItemsControl ItemsSource="{Binding Actions}" ItemTemplate="{StaticResource SwitchCard}" />

                <!-- Wartung -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Protokolle und Zwischenspeicher" />
                <TextBlock Style="{StaticResource SectionText}"
                           Text="Werden beim Start automatisch aufgeräumt: Älteres und alles über der Größengrenze wird gelöscht, das Älteste zuerst." />
                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Höchstens Tage aufheben (1–3650)" />
                        <ui:TextBox Width="160" HorizontalAlignment="Left"
                                    Text="{Binding LogRetentionDays, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="Höchstens Tage aufheben" />
                    </StackPanel>
                    <StackPanel Margin="24,0,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Höchstens MB insgesamt (1–102400)" />
                        <ui:TextBox Width="160" HorizontalAlignment="Left"
                                    Text="{Binding LogMaxSizeMB, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="Höchstens MB insgesamt" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Speichern/Verwerfen bleibt immer sichtbar -->
        <Border Grid.Row="1" Padding="16,10" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Content="Speichern" Appearance="Primary" Icon="{ui:SymbolIcon Save24}"
                           Command="{Binding SaveCommand}" />
                <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Verwerfen" Icon="{ui:SymbolIcon ArrowUndo24}"
                           Command="{Binding DiscardCommand}" />
                <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Visibility="{Binding ErrorText, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
