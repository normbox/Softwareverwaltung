<UserControl x:Class="Softwareverwaltung.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Softwareverwaltung.App.ViewModels"
             xmlns:loc="clr-namespace:Softwareverwaltung.App.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,20,0,4" />
        </Style>
        <Style x:Key="SubsectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="SectionText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>

        <!-- Ein Schalter als Karte: Beschriftung links, Schalter rechts. -->
        <DataTemplate x:Key="SwitchCard" DataType="{x:Type vm:SettingSwitch}">
            <ui:CardControl Margin="0,0,0,4" Padding="14,10">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding IsOn}" AutomationProperties.Name="{Binding Label}"
                                 OnContent="{loc:Text SwitchOn}" OffContent="{loc:Text SwitchOff}" />
            </ui:CardControl>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding IsLoaded}">
            <StackPanel Margin="16,0,16,16" MaxWidth="880" HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource SectionText}" Margin="0,12,0,0"
                           Text="{loc:Text SettingsIntro}" />

                <!-- Nutzung -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Text SettingsUsageTitle}" />
                <TextBlock Style="{StaticResource SectionText}"
                           Text="{loc:Text SettingsUsageText}" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="{loc:Text UsagePrivate}" GroupName="Usage" IsChecked="{Binding IsPrivate}" />
                    <RadioButton Content="{loc:Text UsageCompany}" GroupName="Usage" Margin="16,0,0,0" IsChecked="{Binding IsCompany}" />
                </StackPanel>
                <Expander Header="{loc:Text SettingsUsageTermsExpander}" Margin="0,8,0,0"
                          Visibility="{Binding Usage, Converter={StaticResource NullToVisibility}}">
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="{Binding TermsGeneral}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding ServiceTerms}" ItemTemplate="{StaticResource ServiceTermsTemplate}" />
                    </StackPanel>
                </Expander>

                <!-- Vorlagen -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Text SettingsPresetsTitle}" />
                <TextBlock Style="{StaticResource SectionText}" Text="{loc:Text PresetsText}" />
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="{loc:Text PresetQuick}" Icon="{ui:SymbolIcon Flash24}"
                               Command="{Binding ApplyPresetCommand}" CommandParameter="Quick"
                               ToolTip="{loc:Text PresetQuickTooltip}" />
                    <ui:Button Content="{loc:Text PresetThorough}" Icon="{ui:SymbolIcon Search24}" Margin="8,0,0,0"
                               Command="{Binding ApplyPresetCommand}" CommandParameter="Thorough"
                               ToolTip="{loc:Text PresetThoroughTooltip}" />
                </StackPanel>

                <!-- Quellen -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Text SettingsInstalledTitle}" />
                <TextBlock Style="{StaticResource SectionText}" Text="{loc:Text SettingsInstalledText}" />
                <ItemsControl ItemsSource="{Binding Sources}" ItemTemplate="{StaticResource SwitchCard}" />

                <!-- Suche nach portablen Programmen: Hauptschalter, Info, dann Nutzungsspuren und Dateisuche mit eigenen Schaltern -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Text SettingsPortableTitle}" />

                <ui:CardControl Margin="0,4,0,4" Padding="14,10">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{loc:Text SettingsPortableSwitchLabel}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Text SettingsPortableIntro}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding PortableSearchEnabled}" AutomationProperties.Name="{loc:Text SettingsPortableSwitchLabel}"
                                     OnContent="{loc:Text SwitchOn}" OffContent="{loc:Text SwitchOff}" />
                </ui:CardControl>

                <!-- Neutrale Info direkt unter dem Hauptschalter -->
                <Border Margin="0,0,0,4" Padding="12,10" CornerRadius="4" BorderThickness="1"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Info24" Margin="0,0,10,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{loc:Text SettingsPortableInstalledHint}" TextWrapping="Wrap" MaxWidth="800"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Erst aktiv, wenn der Hauptschalter an ist; vorher ausgegraut -->
                <StackPanel IsEnabled="{Binding PortableSearchEnabled}" Margin="0,8,0,0">

                    <!-- 1. Nutzungsspuren: eigener Schalter, die vier Optionen klappen erst danach auf -->
                    <ui:CardControl Margin="0,0,0,4" Padding="14,10">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{loc:Text SettingsPortableTraceSwitch}" FontWeight="SemiBold" />
                                <TextBlock Text="{loc:Text SettingsPortableTraceSwitchText}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch IsChecked="{Binding TraceSearchEnabled}" AutomationProperties.Name="{loc:Text SettingsPortableTraceSwitch}"
                                         OnContent="{loc:Text SwitchOn}" OffContent="{loc:Text SwitchOff}" />
                    </ui:CardControl>
                    <ItemsControl ItemsSource="{Binding Traces}" ItemTemplate="{StaticResource SwitchCard}" Margin="24,0,0,8"
                                  Visibility="{Binding TraceSearchEnabled, Converter={StaticResource BoolToVisibility}}" />

                    <!-- 2. Dateisuche: eigener Schalter, darunter „Wo suchen“ und Temp, Prüfsumme, Ausschlüsse -->
                    <ui:CardControl Margin="0,4,0,4" Padding="14,10">
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{loc:Text SettingsPortableFileSwitch}" FontWeight="SemiBold" />
                                <TextBlock Text="{loc:Text SettingsPortableFileSwitchText}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </ui:CardControl.Header>
                        <ui:ToggleSwitch IsChecked="{Binding FileSearchEnabled}" AutomationProperties.Name="{loc:Text SettingsPortableFileSwitch}"
                                         OnContent="{loc:Text SwitchOn}" OffContent="{loc:Text SwitchOff}" />
                    </ui:CardControl>

                    <StackPanel Margin="24,0,0,0" Visibility="{Binding FileSearchEnabled, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource SubsectionTitle}" Text="{loc:Text SettingsPortableWhereTitle}" />
                        <TextBlock Style="{StaticResource SectionText}" Text="{loc:Text SettingsPortableWhereText}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton GroupName="ScanMode" Content="{loc:Text SettingsPortableModeDrives}" IsChecked="{Binding IsDrivesMode}" />
                            <RadioButton GroupName="ScanMode" Content="{loc:Text SettingsPortableModeFolders}" IsChecked="{Binding IsFoldersMode}" Margin="24,0,0,0" />
                        </StackPanel>

                        <!-- Ganze Laufwerke -->
                        <StackPanel Visibility="{Binding IsDrivesMode, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text SettingsPortableDrives}" />
                            <ItemsControl ItemsSource="{Binding Drives}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DriveOption}">
                                        <CheckBox Content="{Binding Text}" IsChecked="{Binding IsSelected}" Margin="0,0,16,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Margin="0,8,0,0" Padding="12,10" CornerRadius="4" BorderThickness="1"
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Visibility="{Binding ShowDriveDurationHint, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Clock24" Margin="0,0,10,0" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{loc:Text SettingsPortableDrivesDuration}" TextWrapping="Wrap" MaxWidth="780" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Nur bestimmte Ordner -->
                        <StackPanel Visibility="{Binding IsFoldersMode, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource SectionText}" Text="{loc:Text SettingsPortableFoldersText}" />
                            <ItemsControl ItemsSource="{Binding ScanFolders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,4" Padding="12,6" CornerRadius="4" BorderThickness="1"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <ui:Button Grid.Column="1" Content="{loc:Text SettingsPortableFolderRemove}" Icon="{ui:SymbolIcon Delete24}"
                                                           Appearance="Transparent" Margin="8,0,0,0"
                                                           Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,4,0,0">
                                <ui:Button Content="{loc:Text SettingsPortableFolderPick}" Icon="{ui:SymbolIcon FolderAdd24}"
                                           Command="{Binding PickFolderCommand}" Margin="0,0,16,4" />
                                <TextBlock Text="{loc:Text SettingsPortableFolderSuggestions}" VerticalAlignment="Center" Margin="0,0,8,4"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding FolderSuggestions.Count, Converter={StaticResource CountToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding FolderSuggestions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:Button Content="{Binding}" Icon="{ui:SymbolIcon Add16}" Margin="0,0,8,4"
                                                       Command="{Binding DataContext.AddFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Nichts gewählt: keine Option oder die gewählte Option ohne Eintrag -->
                        <Border Margin="0,8,0,0" Padding="12,10" CornerRadius="4" BorderThickness="1"
                                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Visibility="{Binding NoScanLocation, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Warning24" Filled="True" Margin="0,0,10,0" VerticalAlignment="Top"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                <TextBlock Text="{loc:Text SettingsPortableNoLocation}" TextWrapping="Wrap" MaxWidth="780" />
                            </StackPanel>
                        </Border>

                        <CheckBox Content="{loc:Text SettingsPortableIncludeTemp}" IsChecked="{Binding IncludeTemp}" Margin="0,12,0,0" />
                        <CheckBox Content="{loc:Text SettingsPortableComputeHash}" IsChecked="{Binding ComputeHash}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text SettingsPortableExcludes}" />
                        <ui:TextBox Text="{Binding ExcludePathsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                    MinHeight="64" TextWrapping="NoWrap" AutomationProperties.Name="{loc:Text SettingsPortableExcludes}" />
                        <CheckBox IsChecked="{Binding SmartExclusions}" Margin="0,8,0,0">
                            <TextBlock TextWrapping="Wrap" Text="{loc:Text SettingsPortableSmartExclusions}" />
                        </CheckBox>
                    </StackPanel>
                </StackPanel>

                <!-- Externe Dienste -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Text SettingsServicesTitle}" />
                <TextBlock Style="{StaticResource SectionText}"
                           Text="{loc:Text SettingsServicesText}" />
                <ItemsControl ItemsSource="{Binding Services}" ItemTemplate="{StaticResource SwitchCard}" />

                <!-- API-Schlüssel -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Text SettingsKeysTitle}" />
                <TextBlock Style="{StaticResource SectionText}"
                           Text="{loc:Text SettingsKeysText}" />
                <ItemsControl ItemsSource="{Binding Credentials}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CredentialItem}">
                            <ui:Card Margin="0,0,0,4" Padding="14,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <PasswordBox x:Name="Secret" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                                                 AutomationProperties.Name="{Binding Title}" />
                                    <ui:Button Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Content="{loc:Text CommonSave}" Click="OnSaveCredential" Tag="{Binding ElementName=Secret}" />
                                    <ui:Button Grid.Row="0" Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Content="{loc:Text CommonDelete}" IsEnabled="{Binding Stored}"
                                               Command="{Binding DataContext.RemoveCredentialCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,6,0,0"
                                               Text="{Binding StatusText}" TextWrapping="Wrap" />
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- KI-Berater -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Text SettingsAdvisorTitle}" />
                <TextBlock Style="{StaticResource SectionText}" Text="{loc:Text SettingsAdvisorText}" />
                <Border Margin="0,0,0,8" Padding="14,10" CornerRadius="4" BorderThickness="1"
                        Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Visibility="{Binding ShowShareLevelNotice, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Text SettingsAdvisorNoticeTitle}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Text SettingsAdvisorNoticeText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Content="{loc:Text SettingsAdvisorNoticeConfirm}" Command="{Binding DismissShareLevelNoticeCommand}" />
                    </Grid>
                </Border>
                <ui:CardControl Margin="0,0,0,4" Padding="14,10">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{loc:Text SettingsAdvisorEnabled}" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Text SettingsAdvisorEnabledText}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding AdvisorEnabled}" AutomationProperties.Name="{loc:Text SettingsAdvisorEnabled}"
                                     OnContent="{loc:Text SwitchOn}" OffContent="{loc:Text SwitchOff}" />
                </ui:CardControl>
                <ui:Card Margin="0,0,0,4" Padding="14,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="{loc:Text SettingsAdvisorServer}" />
                        <ComboBox Width="260" HorizontalAlignment="Left" ItemsSource="{Binding AdvisorPresets}"
                                  DisplayMemberPath="Label" SelectedValuePath="Name" SelectedValue="{Binding AdvisorPreset}"
                                  AutomationProperties.Name="{loc:Text SettingsAdvisorServer}" />
                        <TextBlock Style="{StaticResource SectionText}" Margin="0,4,0,0" Text="{Binding AdvisorPresetNote}"
                                   Visibility="{Binding AdvisorPresetNote, Converter={StaticResource NullToVisibility}}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text SettingsAdvisorEndpoint}" />
                        <ui:TextBox Width="420" HorizontalAlignment="Left" PlaceholderText="{loc:Text SettingsAdvisorEndpointPlaceholder}"
                                    Text="{Binding AdvisorEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="{loc:Text SettingsAdvisorEndpoint}" />
                        <TextBlock Style="{StaticResource SectionText}" Margin="0,4,0,0" Text="{loc:Text SettingsAdvisorEndpointText}" />
                        <TextBlock Margin="0,0,0,4" TextWrapping="Wrap" Text="{Binding AdvisorEndpointNote}"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Visibility="{Binding AdvisorEndpointNote, Converter={StaticResource NullToVisibility}}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text SettingsAdvisorModel}" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="320" IsEditable="True" ItemsSource="{Binding AdvisorModels}"
                                      Text="{Binding AdvisorModel, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="{loc:Text SettingsAdvisorModel}" />
                            <ui:Button Margin="8,0,0,0" Content="{loc:Text SettingsAdvisorLoadModels}" Icon="{ui:SymbolIcon ArrowSync24}"
                                       Command="{Binding LoadModelsCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SectionText}" Margin="0,4,0,0" Text="{loc:Text SettingsAdvisorModelText}" />

                        <Grid DataContext="{Binding AdvisorCredential}" Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <PasswordBox x:Name="AdvisorSecret" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                                         AutomationProperties.Name="{Binding Title}" />
                            <ui:Button Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Content="{loc:Text CommonSave}" Click="OnSaveCredential" Tag="{Binding ElementName=AdvisorSecret}" />
                            <ui:Button Grid.Row="0" Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Content="{loc:Text CommonDelete}" IsEnabled="{Binding Stored}"
                                       Command="{Binding DataContext.RemoveCredentialCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,6,0,0"
                                       Text="{Binding StatusText}" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Style="{StaticResource SectionText}" Margin="0,4,0,0" Text="{loc:Text SettingsAdvisorKeyRequired}"
                                   Visibility="{Binding AdvisorPresetNeedsKey, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <ui:Button Content="{loc:Text SettingsAdvisorTest}" Icon="{ui:SymbolIcon PlugConnected24}"
                                       Command="{Binding TestConnectionCommand}" />
                            <ui:ProgressRing Margin="12,0,0,0" Width="20" Height="20" IsIndeterminate="True"
                                             Visibility="{Binding IsAdvisorBusy, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <ui:InfoBar Margin="0,8,0,0" IsOpen="True" IsClosable="False" Title=""
                                    Message="{Binding AdvisorResultText}" Severity="{Binding AdvisorResultSeverity}"
                                    Visibility="{Binding AdvisorResultText, Converter={StaticResource NullToVisibility}}" />

                        <!-- Schutz gegen Endlosschleifen beim Denken des Modells -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text SettingsAdvisorMaxTokens}" />
                                <ui:TextBox Width="160" HorizontalAlignment="Left"
                                            Text="{Binding AdvisorMaxTokens, UpdateSourceTrigger=PropertyChanged}"
                                            AutomationProperties.Name="{loc:Text SettingsAdvisorMaxTokens}" />
                            </StackPanel>
                            <StackPanel Margin="24,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text SettingsAdvisorTimeout}" />
                                <ui:TextBox Width="160" HorizontalAlignment="Left"
                                            Text="{Binding AdvisorTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                            AutomationProperties.Name="{loc:Text SettingsAdvisorTimeout}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SectionText}" Margin="0,4,0,0" Text="{loc:Text SettingsAdvisorLimitsText}" />
                    </StackPanel>
                </ui:Card>

                <TextBlock Style="{StaticResource SubsectionTitle}" Text="{loc:Text SettingsAdvisorShareTitle}" />
                <TextBlock Style="{StaticResource SectionText}" Text="{loc:Text SettingsAdvisorShareText}" />
                <ItemsControl ItemsSource="{Binding ShareLevels}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ShareLevelOption}">
                            <RadioButton GroupName="AdvisorShareLevel" Margin="0,2,0,2" IsChecked="{Binding IsSelected}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,4,0,4" TextWrapping="Wrap" Text="{loc:Text SettingsAdvisorLevel4Hint}"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                           Visibility="{Binding ShowLevel4Hint, Converter={StaticResource BoolToVisibility}}" />
                <Expander Margin="0,8,0,0" Header="{loc:Text SettingsAdvisorPreview}" IsExpanded="{Binding IsPreviewOpen}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionText}" Text="{loc:Text SettingsAdvisorPreviewText}" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding PreviewHint}"
                                   Visibility="{Binding PreviewHint, Converter={StaticResource NullToVisibility}}" />
                        <TextBox IsReadOnly="True" TextWrapping="NoWrap" MaxHeight="360" FontFamily="Consolas"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Text="{Binding PreviewText, Mode=OneWay}" AutomationProperties.Name="{loc:Text SettingsAdvisorPreview}"
                                 Visibility="{Binding PreviewText, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </Expander>

                <!-- Aktionen -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Text SettingsActionsTitle}" />
                <ItemsControl ItemsSource="{Binding Actions}" ItemTemplate="{StaticResource SwitchCard}" />

                <!-- Wartung -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Text SettingsLogsTitle}" />
                <TextBlock Style="{StaticResource SectionText}"
                           Text="{loc:Text SettingsLogsText}" />
                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text SettingsLogsMaxDays}" />
                        <ui:TextBox Width="160" HorizontalAlignment="Left"
                                    Text="{Binding LogRetentionDays, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="{loc:Text SettingsLogsMaxDaysName}" />
                    </StackPanel>
                    <StackPanel Margin="24,0,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text SettingsLogsMaxSize}" />
                        <ui:TextBox Width="160" HorizontalAlignment="Left"
                                    Text="{Binding LogMaxSizeMB, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="{loc:Text SettingsLogsMaxSizeName}" />
                    </StackPanel>
                    <StackPanel Margin="24,0,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text SettingsCirclStoreMaxSize}" />
                        <ui:TextBox Width="160" HorizontalAlignment="Left"
                                    Text="{Binding CirclStoreMaxSizeMB, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="{loc:Text SettingsCirclStoreMaxSizeTooltip}"
                                    AutomationProperties.Name="{loc:Text SettingsCirclStoreMaxSizeName}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Text SettingsCacheTitle}" />
                <TextBlock Style="{StaticResource SectionText}" Text="{loc:Text SettingsCacheText}" />
                <WrapPanel>
                    <StackPanel Margin="0,0,24,8">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text SettingsCacheLatestVersion}" />
                        <ui:TextBox Width="160" HorizontalAlignment="Left" Text="{Binding CacheHoursLatestVersion, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="{loc:Text SettingsCacheLatestVersion}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,24,8">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text SettingsCacheNvd}" />
                        <ui:TextBox Width="160" HorizontalAlignment="Left" Text="{Binding CacheHoursNvd, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="{loc:Text SettingsCacheNvd}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,24,8">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text SettingsCacheCircl}" />
                        <ui:TextBox Width="160" HorizontalAlignment="Left" Text="{Binding CacheHoursCircl, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="{loc:Text SettingsCacheCircl}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,24,8">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text SettingsCacheEpss}" />
                        <ui:TextBox Width="160" HorizontalAlignment="Left" Text="{Binding CacheHoursEpss, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="{loc:Text SettingsCacheEpss}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,24,8">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text SettingsCacheKev}" />
                        <ui:TextBox Width="160" HorizontalAlignment="Left" Text="{Binding CacheHoursKev, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="{loc:Text SettingsCacheKev}" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Speichern/Verwerfen bleibt immer sichtbar -->
        <Border Grid.Row="1" Padding="16,10" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Content="{loc:Text CommonSave}" Appearance="Primary" Icon="{ui:SymbolIcon Save24}"
                           Command="{Binding SaveCommand}" />
                <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="{loc:Text CommonDiscard}" Icon="{ui:SymbolIcon ArrowUndo24}"
                           Command="{Binding DiscardCommand}" />
                <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Visibility="{Binding ErrorText, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
