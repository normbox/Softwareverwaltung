<ui:FluentWindow x:Class="Softwareverwaltung.App.Views.QueueConfirmWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:Softwareverwaltung.App.Localization"
                 xmlns:models="clr-namespace:Softwareverwaltung.App.Models"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=models:QueueConfirmation}"
                 Title="{loc:Text QueueConfirmTitle}"
                 Width="720" SizeToContent="Height" MaxHeight="720"
                 ResizeMode="NoResize" ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Window.Resources>
        <!-- Ein Eintrag: Name, Versionen, „unbestätigt“, genauer Befehl -->
        <DataTemplate x:Key="EntryTemplate" DataType="{x:Type models:QueueEntry}">
            <StackPanel Margin="0,6,0,0">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding VersionText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{loc:Text QueueUnconfirmed}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap"
                           Visibility="{Binding Unconfirmed, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding CommandLine}" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding Executable, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding Reason, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{loc:Text QueueConfirmTitle}" ShowMaximize="False" ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,8">
                <TextBlock Text="{Binding SummaryText}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />

                <TextBlock Text="{loc:Text QueueGroupElevated}" FontWeight="SemiBold" Margin="0,16,0,0"
                           Visibility="{Binding Elevated.Count, Converter={StaticResource CountToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Elevated}" ItemTemplate="{StaticResource EntryTemplate}" />

                <TextBlock Text="{loc:Text QueueGroupNormal}" FontWeight="SemiBold" Margin="0,16,0,0"
                           Visibility="{Binding Normal.Count, Converter={StaticResource CountToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Normal}" ItemTemplate="{StaticResource EntryTemplate}" />

                <TextBlock Text="{loc:Text QueueGroupNotExecutable}" FontWeight="SemiBold" Margin="0,16,0,0"
                           Visibility="{Binding NotExecutable.Count, Converter={StaticResource CountToVisibility}}" />
                <ItemsControl ItemsSource="{Binding NotExecutable}" ItemTemplate="{StaticResource EntryTemplate}" />

                <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{loc:Text QueueConfirmHint}" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="StartButton" Content="{loc:Text QueueConfirmStart}" Appearance="Primary" Click="OnStart"
                           IsEnabled="{Binding CanStart}" />
                <!-- Standard-Button ist „Abbrechen“: Enter allein startet nichts -->
                <ui:Button Content="{loc:Text CommonCancel}" Margin="8,0,0,0" IsCancel="True" IsDefault="True" Click="OnCancel" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
