<UserControl x:Class="Softwareverwaltung.App.Views.BackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Softwareverwaltung.App.Localization"
             xmlns:vm="clr-namespace:Softwareverwaltung.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BackupsViewModel}">
    <UserControl.Resources>
        <!-- Textspalten: voller Text als Tooltip, wenn die Spalte ihn abschneidet -->
        <Style x:Key="TextCellWithTooltip" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="ToolTip" Value="{x:Null}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="16,8,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="{loc:Text BackupsTitle}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Text BackupsIntro}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <!-- Hinweis zu den Sicherungen für alle Benutzer: abgelaufen (Aufräumen nur auf Klick) oder Ordner nicht lesbar -->
            <Border Margin="0,8,0,0" Padding="12,8" CornerRadius="4" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Visibility="{Binding ShowMachineNotice, Converter={StaticResource BoolToVisibility}}">
                <DockPanel LastChildFill="True">
                    <ui:Button DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                               Content="{loc:Text BackupsClearExpired}" Icon="{ui:SymbolIcon Shield24}"
                               Command="{Binding ClearExpiredCommand}"
                               Visibility="{Binding ShowClearExpired, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding MachineNotice}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Ergebnis der letzten Aktion -->
        <Border Grid.Row="1" Margin="0,0,0,8" Padding="12,10" CornerRadius="4" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Visibility="{Binding LastOutcome, Converter={StaticResource NullToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                        <Run Text="{Binding LastOutcome.ActionText, Mode=OneWay}" /><Run Text=" – " /><Run Text="{Binding LastOutcome.Name, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding LastOutcome.ResultText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding LastOutcome.Message}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding LastOutcome.Message, Converter={StaticResource NullToVisibility}}" />
                </StackPanel>
                <ui:Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top" Appearance="Transparent"
                           Icon="{ui:SymbolIcon Dismiss16}" ToolTip="{loc:Text CommonClose}" AutomationProperties.Name="{loc:Text ActionResultClose}"
                           Command="{Binding DismissOutcomeCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <DataGrid ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column"
                      CanUserReorderColumns="False"
                      AutomationProperties.Name="{loc:Text BackupsListName}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Text ColumnBackupName}" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource TextCellWithTooltip}" />
                    <DataGridTextColumn Header="{loc:Text ColumnBackupScope}" Binding="{Binding ScopeText}" Width="110" ElementStyle="{StaticResource TextCellWithTooltip}" />
                    <DataGridTextColumn Header="{loc:Text ColumnBackupDate}" Binding="{Binding WhenText}" SortMemberPath="CreatedAt" Width="160" ElementStyle="{StaticResource TextCellWithTooltip}" />
                    <DataGridTextColumn Header="{loc:Text ColumnBackupReasons}" Binding="{Binding ReasonsText}" Width="2*" ElementStyle="{StaticResource TextCellWithTooltip}" />
                    <DataGridTextColumn Header="{loc:Text ColumnBackupKey}" Binding="{Binding NativeKey}" Width="3*" ElementStyle="{StaticResource TextCellWithTooltip}" />
                    <DataGridTextColumn Header="{loc:Text ColumnBackupStatus}" Binding="{Binding StatusText}" Width="2*" ElementStyle="{StaticResource TextCellWithTooltip}" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{loc:Text BackupsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,8,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <ui:Button Content="{loc:Text BackupsRefresh}" Icon="{ui:SymbolIcon ArrowClockwise24}" Margin="0,0,8,0"
                           Command="{Binding LoadCommand}" />
                <ui:Button Content="{loc:Text BackupsRestore}" Icon="{ui:SymbolIcon ArrowUndo24}" Margin="0,0,8,0" Appearance="Primary"
                           ToolTip="{loc:Text BackupsRestoreTooltip}" Command="{Binding RestoreCommand}" />
                <ui:Button Content="{loc:Text BackupsDelete}" Icon="{ui:SymbolIcon Delete24}"
                           ToolTip="{loc:Text BackupsDeleteTooltip}" Command="{Binding DeleteCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" Margin="16,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</UserControl>
