<ui:FluentWindow x:Class="Softwareverwaltung.App.Views.ConfirmActionWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:Softwareverwaltung.App.Localization"
                 xmlns:models="clr-namespace:Softwareverwaltung.App.Models"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=models:ActionOutcome}"
                 Title="{loc:Text ConfirmTitle}"
                 Width="620" SizeToContent="Height" MaxHeight="640"
                 ResizeMode="NoResize" ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{loc:Text ConfirmTitle}" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,8,24,8">
            <TextBlock FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap">
                <Run Text="{Binding ActionText, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Name, Mode=OneWay}" />
            </TextBlock>

            <TextBlock Text="{loc:Text ConfirmCommandLabel}" Margin="0,16,0,4" FontWeight="SemiBold" />
            <ui:TextBox Text="{Binding CommandLine, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                        FontFamily="Cascadia Mono, Consolas" AutomationProperties.Name="{loc:Text ConfirmCommandName}" />

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <ui:SymbolIcon Symbol="Shield24" Margin="0,0,8,0" />
                <TextBlock Text="{Binding RightsText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <ui:SymbolIcon Symbol="History24" Margin="0,0,8,0" />
                <TextBlock Text="{Binding RestorePointText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{loc:Text ConfirmHint}" />
        </StackPanel>

        <Border Grid.Row="2" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="ExecuteButton" Content="{Binding ActionText}" Appearance="Primary" Click="OnExecute" />
                <ui:Button Content="{loc:Text CommonCancel}" Margin="8,0,0,0" IsCancel="True" IsDefault="True" Click="OnCancel" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
