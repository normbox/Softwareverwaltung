<ui:FluentWindow x:Class="Softwareverwaltung.App.Views.CpeMappingWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:Softwareverwaltung.App.Localization"
                 xmlns:models="clr-namespace:Softwareverwaltung.App.Models"
                 xmlns:vm="clr-namespace:Softwareverwaltung.App.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:CpeMappingViewModel}"
                 Title="{loc:Text CpeMappingTitle}"
                 Width="640" SizeToContent="Height" MaxHeight="720"
                 ResizeMode="NoResize" ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{loc:Text CpeMappingTitle}" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,8,24,8">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ProgramText}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- Bestehende eigene Zuordnung -->
            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding CurrentCpe, Converter={StaticResource NullToVisibility}}">
                <Run Text="{loc:Text CpeMappingCurrent}" /><Run Text="{Binding CurrentCpe, Mode=OneWay}" />
            </TextBlock>

            <TextBlock Text="{loc:Text CpeMappingCandidatesTitle}" FontWeight="SemiBold" Margin="0,12,0,0" />
            <TextBlock Text="{loc:Text CpeMappingUnconfirmedHint}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}">
                <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" Margin="0,0,8,0" />
                <TextBlock Text="{loc:Text CpeMappingSearching}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding ShowHint, Converter={StaticResource BoolToVisibility}}" />
            <ListBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}" MaxHeight="220" Margin="0,8,0,0"
                     AutomationProperties.Name="{loc:Text CpeMappingCandidatesTitle}"
                     Visibility="{Binding Candidates.Count, Converter={StaticResource CountToVisibility}}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:CpeCandidate}">
                        <StackPanel>
                            <TextBlock Text="{Binding Cpe}" FontFamily="Consolas" />
                            <WrapPanel>
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding DetailsText}" />
                                <ui:HyperlinkButton Content="{loc:Text CpeCandidateOpenNvd}" NavigateUri="{Binding Url}" Padding="0" Margin="8,0,0,0" />
                            </WrapPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="{loc:Text CpeMappingInputLabel}" FontWeight="SemiBold" Margin="0,12,0,4" />
            <ui:TextBox Text="{Binding CpeText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Text CpeMappingPlaceholder}"
                        FontFamily="Consolas" AutomationProperties.Name="{loc:Text CpeMappingInputLabel}" />
            <TextBlock Text="{loc:Text CpeMappingInvalid}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Visibility="{Binding ShowCpeInvalid, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{loc:Text CpeMappingCheckHint}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="2" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel LastChildFill="False">
                <ui:Button DockPanel.Dock="Left" Content="{loc:Text CpeMappingRemove}" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveCommand}"
                           Visibility="{Binding CurrentCpe, Converter={StaticResource NullToVisibility}}" />
                <!-- Standard-Button ist „Abbrechen“: Enter allein ordnet nichts zu -->
                <ui:Button DockPanel.Dock="Right" Content="{loc:Text CommonCancel}" Margin="8,0,0,0" IsCancel="True" IsDefault="True" Click="OnCancel" />
                <ui:Button DockPanel.Dock="Right" Content="{loc:Text CpeMappingAssign}" Appearance="Primary" Command="{Binding AssignCommand}" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
