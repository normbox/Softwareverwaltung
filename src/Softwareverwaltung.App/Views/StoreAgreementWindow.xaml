<ui:FluentWindow x:Class="Softwareverwaltung.App.Views.StoreAgreementWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:Softwareverwaltung.App.Localization"
                 xmlns:models="clr-namespace:Softwareverwaltung.App.Models"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=models:StoreAgreement}"
                 Title="{loc:Text StoreAgreementTitle}"
                 Width="600" SizeToContent="Height" MaxHeight="640"
                 ResizeMode="NoResize" ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{loc:Text StoreAgreementTitle}" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,8,24,8">
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
            <ui:HyperlinkButton Content="{loc:Text StoreAgreementOpenTerms}" NavigateUri="{Binding Url}" Padding="0" Margin="0,12,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{loc:Text StoreAgreementAccept}" Appearance="Primary" Click="OnAccept" />
                <!-- Standard-Button ist „Abbrechen“: Enter allein stimmt nicht zu -->
                <ui:Button Content="{loc:Text CommonCancel}" Margin="8,0,0,0" IsCancel="True" IsDefault="True" Click="OnCancel" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
