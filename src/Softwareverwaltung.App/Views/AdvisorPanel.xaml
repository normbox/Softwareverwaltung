<UserControl x:Class="Softwareverwaltung.App.Views.AdvisorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Softwareverwaltung.App.Localization"
             xmlns:vm="clr-namespace:Softwareverwaltung.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AdvisorChatViewModel}"
             AutomationProperties.Name="{loc:Text AdvisorPanelName}">
    <!-- Seitenleiste des KI-Beraters: links ziehbar (Breite gemerkt in app-ui.json). Antworten als reiner Text,
         ohne Links. Vorschläge führen nichts aus. -->
    <Border x:Name="Root" Margin="0,0,8,8" CornerRadius="8" BorderThickness="1"
            TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Thumb Grid.Column="0" Cursor="SizeWE" Background="Transparent" ToolTip="{loc:Text AdvisorPanelResizeTooltip}"
                   DragDelta="OnResizeDelta" DragCompleted="OnResizeCompleted">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <DockPanel Grid.Column="1" Margin="6,8,10,10">
                <!-- Kopf -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent" Padding="6"
                               AutomationProperties.Name="{loc:Text CommonClose}" Command="{Binding ToggleCommand}" />
                    <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon ChatAdd24}" Appearance="Transparent" Padding="6" Margin="0,0,4,0"
                               ToolTip="{loc:Text AdvisorChatNewTooltip}" AutomationProperties.Name="{loc:Text AdvisorChatNew}"
                               Command="{Binding NewConversationCommand}" />
                    <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{loc:Text AdvisorPanelTitle}" />
                </DockPanel>

                <!-- Eingabe -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0"
                            Visibility="{Binding CanType, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding StateText}" Visibility="{Binding StateText, Converter={StaticResource NullToVisibility}}" />
                    <ui:TextBox x:Name="QuestionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="180"
                                VerticalScrollBarVisibility="Auto" PlaceholderText="{loc:Text AdvisorChatInputPlaceholder}"
                                AutomationProperties.Name="{loc:Text AdvisorChatInputName}"
                                Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}"
                                PreviewKeyDown="OnQuestionKeyDown" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True" Margin="0,0,10,0"
                                         Visibility="{Binding IsAnswering, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Content="{loc:Text AdvisorChatCancel}" Icon="{ui:SymbolIcon Stop24}" Margin="0,0,8,0"
                                   Command="{Binding SendCancelCommand}"
                                   Visibility="{Binding IsAnswering, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Content="{loc:Text AdvisorChatSend}" Icon="{ui:SymbolIcon Send24}" Appearance="Primary"
                                   Command="{Binding SendCommand}" />
                    </StackPanel>
                </StackPanel>

                <Grid>
                    <!-- Leere Zustände -->
                    <StackPanel VerticalAlignment="Center" Margin="8,0"
                                Visibility="{Binding ShowDisabledState, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{loc:Text AdvisorChatDisabled}" />
                        <ui:Button HorizontalAlignment="Center" Margin="0,12,0,0" Content="{loc:Text AdvisorChatOpenSettings}"
                                   Icon="{ui:SymbolIcon Settings24}" Command="{Binding OpenSettingsCommand}" />
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" Margin="8,0" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{loc:Text AdvisorChatNoScan}"
                               Visibility="{Binding ShowNoScanState, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel VerticalAlignment="Center" Margin="8,0"
                                Visibility="{Binding ShowEmptyConversation, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Text="{loc:Text AdvisorChatEmpty}" />
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{loc:Text AdvisorChatPrivacy}" />
                    </StackPanel>

                    <!-- Verlauf -->
                    <ScrollViewer x:Name="History" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding ShowHistory, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AdvisorChatEntry}">
                                    <Border x:Name="Bubble" Margin="0,0,0,8" Padding="10,8" CornerRadius="6" BorderThickness="1"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                        <StackPanel>
                                            <TextBlock x:Name="Label" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Visibility="{Binding Detail, Converter={StaticResource NullToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                            <Setter TargetName="Bubble" Property="Margin" Value="32,0,0,8" />
                                            <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            <Setter TargetName="Label" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Label" Property="Text" Value="{loc:Text AdvisorChatLabelUser}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                                            <Setter TargetName="Bubble" Property="Margin" Value="0,0,16,8" />
                                            <Setter TargetName="Label" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Label" Property="Text" Value="{loc:Text AdvisorChatLabelAssistant}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsInfo}" Value="True">
                                            <Setter TargetName="Bubble" Property="Background" Value="Transparent" />
                                            <Setter TargetName="Bubble" Property="BorderThickness" Value="0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
