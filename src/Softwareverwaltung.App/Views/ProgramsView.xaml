<UserControl x:Class="Softwareverwaltung.App.Views.ProgramsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Softwareverwaltung.App.Localization"
             xmlns:vm="clr-namespace:Softwareverwaltung.App.ViewModels"
             xmlns:models="clr-namespace:Softwareverwaltung.App.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <UserControl.Resources>
        <!-- Textspalten: voller Text als Tooltip, wenn die Spalte ihn abschneidet -->
        <Style x:Key="TextCellWithTooltip" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="ToolTip" Value="{x:Null}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Werkzeugleiste -->
        <Grid Grid.Row="0" Margin="16,8,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MaxWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" Content="{loc:Text ProgramsScan}" Appearance="Primary"
                       Icon="{ui:SymbolIcon ArrowSync24}"
                       Command="{Binding ScanCommand}"
                       ToolTip="{loc:Text ProgramsScanTooltip}" />
            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="{loc:Text CommonCancel}"
                       Icon="{ui:SymbolIcon Dismiss24}"
                       Command="{Binding ScanCancelCommand}"
                       Visibility="{Binding ScanCommand.IsRunning, Converter={StaticResource BoolToVisibility}}" />
            <ui:TextBox Grid.Column="2" Margin="12,0,0,0"
                        PlaceholderText="{loc:Text ProgramsSearchPlaceholder}"
                        Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="{loc:Text ProgramsSearchName}" />
            <CheckBox Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center"
                      Content="{loc:Text ProgramsFilterUpdates}" IsChecked="{Binding ShowUpdatesOnly}" />
            <CheckBox Grid.Column="4" Margin="16,0,0,0" VerticalAlignment="Center"
                      Content="{loc:Text ProgramsFilterRisks}" IsChecked="{Binding ShowRisksOnly}"
                      ToolTip="{loc:Text ProgramsFilterRisksTooltip}" />
            <TextBlock Grid.Column="6" VerticalAlignment="Center" Text="{Binding CountText}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="16,0,16,0">
        <!-- Ergebnis der letzten Aktion -->
        <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="4" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Visibility="{Binding LastOutcome, Converter={StaticResource NullToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                        <Run Text="{Binding LastOutcome.ActionText, Mode=OneWay}" /><Run Text=" – " /><Run Text="{Binding LastOutcome.Name, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding LastOutcome.ResultText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding LastOutcome.Message}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding LastOutcome.Message, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Text="{Binding LastOutcome.RestorePointText}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <ui:Button Margin="0,0,12,0" Command="{Binding RetryWithNextMethodCommand}"
                                   Visibility="{Binding CanRetryWithNextMethod, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding LastOutcome.RetryText, Mode=OneWay}" />
                        </ui:Button>
                        <ui:HyperlinkButton Content="{loc:Text ActionVendorPage}" NavigateUri="{Binding LastOutcome.VendorUrl}" Padding="0" VerticalAlignment="Center"
                                            Visibility="{Binding LastOutcome.VendorUrl, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </StackPanel>
                <ui:Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top" Appearance="Transparent"
                           Icon="{ui:SymbolIcon Dismiss16}" ToolTip="{loc:Text CommonClose}" AutomationProperties.Name="{loc:Text ActionResultClose}"
                           Command="{Binding DismissOutcomeCommand}" />
            </Grid>
        </Border>

        <!-- Hinweise: winget fehlt, keine Quelle aktiviert, Fehler des Moduls -->
        <ItemsControl ItemsSource="{Binding Notices}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:Notice}">
                    <Border x:Name="Card" Margin="0,0,0,8" Padding="12,10" CornerRadius="4" BorderThickness="1"
                            Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon x:Name="Icon" Grid.Column="0" Symbol="Info24" Filled="True" FontSize="18"
                                           VerticalAlignment="Top" Margin="0,1,10,0"
                                           Foreground="{DynamicResource SystemFillColorAttentionBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <ui:Button Content="{Binding ActionText}" Command="{Binding Action}" Margin="0,0,12,0"
                                               Visibility="{Binding Action, Converter={StaticResource NullToVisibility}}" />
                                    <ui:HyperlinkButton Content="{Binding LinkText}" NavigateUri="{Binding Link}" Padding="0" VerticalAlignment="Center"
                                                        Visibility="{Binding Link, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                            </StackPanel>
                            <ui:Button Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Top" Appearance="Transparent"
                                       Icon="{ui:SymbolIcon Dismiss16}" ToolTip="{loc:Text NoticeDismiss}"
                                       AutomationProperties.Name="{loc:Text NoticeDismissName}"
                                       Command="{Binding DataContext.DismissNoticeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:NoticeSeverity.Warning}">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                            <Setter TargetName="Icon" Property="Symbol" Value="Warning24" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:NoticeSeverity.Error}">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                            <Setter TargetName="Icon" Property="Symbol" Value="ErrorCircle24" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </StackPanel>

        <!-- Hauptliste -->
        <Grid Grid.Row="2" Margin="16,0,16,8">
            <DataGrid ItemsSource="{Binding ItemsView}"
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column"
                      CanUserReorderColumns="False"
                      RowDetailsVisibilityMode="VisibleWhenSelected"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      AutomationProperties.Name="{loc:Text ProgramsListName}"
                      PreviewMouseLeftButtonDown="OnGridPreviewMouseLeftButtonDown">
                <!-- Esc klappt die Details zu -->
                <DataGrid.InputBindings>
                    <KeyBinding Key="Escape" Command="{Binding CloseDetailsCommand}" />
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{loc:Text ColumnRating}" SortMemberPath="Rating" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:SoftwareItem}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding ReasonText}">
                                    <Ellipse Width="12" Height="12" Fill="{Binding Rating, Converter={StaticResource RatingToBrush}}" />
                                    <TextBlock Margin="6,0,0,0" Text="{Binding Rating, Converter={StaticResource RatingToText}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{loc:Text ColumnName}" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource TextCellWithTooltip}" />
                    <DataGridTextColumn Header="{loc:Text ColumnPublisher}" Binding="{Binding Publisher}" Width="*" ElementStyle="{StaticResource TextCellWithTooltip}" />
                    <DataGridTextColumn Header="{loc:Text ColumnInstalled}" Binding="{Binding InstalledVersion}" Width="140" ElementStyle="{StaticResource TextCellWithTooltip}" />
                    <DataGridTemplateColumn Header="{loc:Text ColumnLatest}" SortMemberPath="LatestVersion" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:SoftwareItem}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LatestVersion}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LatestVersion}" />
                                    <TextBlock Margin="4,0,0,0" Text="{loc:Text LatestUnconfirmed}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               ToolTip="{loc:Text LatestUnconfirmedTooltip}"
                                               Visibility="{Binding LatestVersionUnconfirmed, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{loc:Text ColumnVulnerabilities}" Binding="{Binding VulnerabilityText}" SortMemberPath="VulnerabilityCount" Width="110" ElementStyle="{StaticResource TextCellWithTooltip}" />
                    <DataGridTemplateColumn Header="{loc:Text ColumnReason}" SortMemberPath="ReasonSummary" Width="3*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:SoftwareItem}">
                                <TextBlock Text="{Binding ReasonSummary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           ToolTip="{Binding ReasonText}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{loc:Text ColumnSource}" Binding="{Binding Sources}" Width="140" ElementStyle="{StaticResource TextCellWithTooltip}" />
                </DataGrid.Columns>

                <!-- Angeklickte Zeile: alle Gründe, Lücken und widerlegte Treffer -->
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate DataType="{x:Type models:SoftwareItem}">
                        <StackPanel Margin="32,6,16,12">
                            <DockPanel Margin="0,0,0,8" LastChildFill="False">
                            <!-- Schließen klappt die Details zu, ebenso Esc und ein zweiter Klick auf die Zeile -->
                            <ui:Button DockPanel.Dock="Right" Content="{loc:Text CommonClose}" Icon="{ui:SymbolIcon ChevronUp24}"
                                       ToolTip="{loc:Text DetailsCloseTooltip}"
                                       Command="{Binding DataContext.CloseDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            <!-- Aktionen: erst Bestätigungsdialog mit genauem Befehl, dann Ausführung -->
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                                        Visibility="{Binding DataContext.ActionsAvailable, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibility}}">
                                <ui:Button Content="{loc:Text ActionUpdate}" Appearance="Primary" Icon="{ui:SymbolIcon ArrowUpload24}" Margin="0,0,8,0"
                                           Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding}"
                                           Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}" />
                                <ui:Button Content="{loc:Text ActionUninstall}" Icon="{ui:SymbolIcon Delete24}"
                                           Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           CommandParameter="{Binding}" />
                            </StackPanel>
                            </DockPanel>

                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding InstallInfo, Converter={StaticResource NullToVisibility}}">
                                <Run Text="{loc:Text DetailsInstallLabel}" /><Run Text="{Binding InstallInfo, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding WingetId, Converter={StaticResource NullToVisibility}}">
                                <Run Text="{loc:Text DetailsWingetIdLabel}" /><Run Text="{Binding WingetId, Mode=OneWay}" />
                            </TextBlock>

                            <!-- Installationsordner: ermittelt das Modul erst beim Aufklappen, mit Herkunft oder Grund -->
                            <StackPanel Margin="0,0,0,8" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding SelectedLocation.IsKnown, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                    <Run Text="{loc:Text DetailsFolderLabel}" /><Run Text="{Binding SelectedLocation.Path, Mode=OneWay}" />
                                    <Run Text="{Binding SelectedLocation.Note, Mode=OneWay, StringFormat='({0})'}" />
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding SelectedLocation.Reason, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}">
                                    <Run Text="{loc:Text DetailsFolderUnknown}" /><Run Text="{Binding SelectedLocation.Reason, Mode=OneWay}" />
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                            Visibility="{Binding SelectedLocation.IsKnown, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                    <ui:Button Content="{loc:Text DetailsOpenFolder}" Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,0,8,0"
                                               Command="{Binding OpenFolderCommand}"
                                               Visibility="{Binding SelectedLocation.CanOpen, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                    <ui:Button Content="{loc:Text DetailsCopyPath}" Icon="{ui:SymbolIcon Copy24}" Command="{Binding CopyPathCommand}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{loc:Text DetailsReasonsTitle}" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding Reasons}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{loc:Text DetailsVulnerabilitiesTitle}" FontWeight="SemiBold" Margin="0,8,0,0"
                                       Visibility="{Binding VulnerabilityText, Converter={StaticResource NullToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Vulnerabilities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:VulnerabilityItem}">
                                        <StackPanel Margin="0,4,0,0">
                                            <WrapPanel>
                                                <ui:HyperlinkButton Content="{Binding CveId}" NavigateUri="{Binding Url}" Padding="0" />
                                                <TextBlock Text="{Binding Summary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </WrapPanel>
                                            <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontStyle="Italic"
                                                       Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}" />
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Visibility="{Binding Description, Converter={StaticResource NullToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Refuted}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='✓ {0}'}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Versionsverlauf: bisherige Aktionen zu diesem Programm aus dem Aktionsprotokoll -->
                            <TextBlock Text="{loc:Text DetailsHistoryTitle}" FontWeight="SemiBold" Margin="0,8,0,0"
                                       Visibility="{Binding DataContext.History.Count, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource CountToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding DataContext.History, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ActionHistoryEntry}">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" ToolTip="{Binding Message}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
            </DataGrid>

            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                       Text="{loc:Text ProgramsEmpty}" />
        </Grid>

        <!-- Statuszeile -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="16,0,16,10">
            <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" Margin="0,0,8,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
