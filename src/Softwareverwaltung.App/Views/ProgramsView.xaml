<UserControl x:Class="Softwareverwaltung.App.Views.ProgramsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Softwareverwaltung.App.Localization"
             xmlns:vm="clr-namespace:Softwareverwaltung.App.ViewModels"
             xmlns:models="clr-namespace:Softwareverwaltung.App.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <!-- Esc schließt das Detailfeld, auch wenn der Fokus darin liegt -->
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseDetailsCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <!-- Textspalten: voller Text als Tooltip, wenn die Spalte ihn abschneidet -->
        <Style x:Key="TextCellWithTooltip" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="ToolTip" Value="{x:Null}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Schlanke Aufklappzeile (▸/▾) statt der Kartenoptik von WPF-UI, damit viele Lücken ruhig untereinander stehen -->
        <Style x:Key="CompactExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <!-- HeaderSite: unter diesem Namen bindet WPF den Kopf an die Barrierefreiheit (Aufklappen per Screenreader) -->
                            <!-- Foreground ausdrücklich: der ToggleButton-Stil von WPF-UI setzt sonst eine eigene, im dunklen Design fast schwarze Farbe -->
                            <ToggleButton x:Name="HeaderSite" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                          Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}"
                                          ToolTip="{TemplateBinding ToolTip}" Cursor="Hand" Focusable="True">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="2,3,6,3">
                                            <DockPanel>
                                                <TextBlock x:Name="Chevron" Text="▸" Width="16" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="Text" Value="▾" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="18,2,0,8" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Inhalt des Detailfelds rechts über der Liste -->
        <DataTemplate x:Key="ProgramDetailsTemplate" DataType="{x:Type models:SoftwareItem}">
            <StackPanel Margin="0,0,0,12">
                <DockPanel Margin="0,0,0,8" LastChildFill="False">
                <!-- Aktionen: erst Bestätigungsdialog mit genauem Befehl, dann Ausführung -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"
                            Visibility="{Binding DataContext.ActionsAvailable, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                    <ui:Button Content="{loc:Text ActionUpdate}" Appearance="Primary" Icon="{ui:SymbolIcon ArrowUpload24}" Margin="0,0,8,0"
                               Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}"
                               Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Content="{loc:Text ActionUninstall}" Icon="{ui:SymbolIcon Delete24}" Margin="0,0,8,0"
                               Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}" />
                    <ui:Button Content="{loc:Text DetailsRecheckWithoutCache}" Icon="{ui:SymbolIcon ArrowSync24}"
                               ToolTip="{loc:Text DetailsRecheckWithoutCacheTooltip}"
                               Command="{Binding DataContext.RecheckWithoutCacheCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}" />
                </StackPanel>
                </DockPanel>

                <!-- Gründe: höchstens drei sichtbar, der Rest zum Aufklappen -->
                <TextBlock Text="{loc:Text DetailsReasonsTitle}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding ReasonsShown}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Expander Style="{StaticResource CompactExpander}" Header="{Binding ReasonsMoreText}"
                          AutomationProperties.Name="{Binding ReasonsMoreText}"
                          Visibility="{Binding ReasonsMoreText, Converter={StaticResource NullToVisibility}}">
                    <ItemsControl ItemsSource="{Binding ReasonsMore}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <!-- Lücken: eine Zeile je CVE, aufklappbar für Quellen, Links und Beschreibung -->
                <TextBlock Text="{loc:Text DetailsVulnerabilitiesTitle}" FontWeight="SemiBold" Margin="0,8,0,0"
                           Visibility="{Binding VulnerabilityText, Converter={StaticResource NullToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Vulnerabilities}" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:VulnerabilityItem}">
                            <Expander Style="{StaticResource CompactExpander}"
                                      AutomationProperties.Name="{Binding AccessibleName}"
                                      ToolTip="{loc:Text VulnerabilityExpandTooltip}">
                                <Expander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Cve" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Assessment" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Kev" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Score" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding CveId}" FontWeight="SemiBold" Margin="0,0,16,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding AssessmentShort}" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="2" Text="{loc:Text VulnerabilityKevShort}" Margin="0,0,12,0" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                   ToolTip="{loc:Text VulnerabilityKevShortTooltip}"
                                                   Visibility="{Binding Kev, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Grid.Column="3" Text="{Binding ScoreText}" Margin="0,0,16,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ItemsControl Grid.Column="4" ItemsSource="{Binding Sources}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:SourceStatementItem}">
                                                    <TextBlock Text="{Binding ShortText}" ToolTip="{Binding Line}" Margin="0,0,12,0"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Expander.Header>
                                <StackPanel>
                                    <!-- Nur, was die Kopfzeile nicht schon zeigt: EPSS, Hinweis, Angaben der Quellen mit Link, Beschreibung -->
                                    <TextBlock Text="{Binding EpssText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding EpssText, Converter={StaticResource NullToVisibility}}" />
                                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontStyle="Italic"
                                               Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}" />
                                    <!-- Angabe jeder Quelle einzeln; die Namensnennung steht einmal unter der Liste -->
                                    <ItemsControl ItemsSource="{Binding Sources}" Margin="0,2,0,2">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:SourceStatementItem}">
                                                <StackPanel Margin="0,1,0,1">
                                                    <WrapPanel>
                                                        <TextBlock Text="{Binding Line}" VerticalAlignment="Center" />
                                                        <ui:HyperlinkButton Content="{loc:Text SourceOpen}" NavigateUri="{Binding Url}" Padding="0" Margin="8,0,0,0"
                                                                            Visibility="{Binding Url, Converter={StaticResource NullToVisibility}}"
                                                                            AutomationProperties.Name="{Binding Line}" />
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontStyle="Italic"
                                                               Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding Description, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Zeichenerklärung und Namensnennung einmal unter der Liste -->
                <StackPanel Margin="18,4,0,0" Visibility="{Binding Vulnerabilities.Count, Converter={StaticResource CountToVisibility}}">
                    <TextBlock Text="{loc:Text DetailsSourceLegend}" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ItemsControl ItemsSource="{Binding Attributions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="{loc:Text DetailsProgramTitle}" FontWeight="SemiBold" Margin="0,12,0,4" />
                <!-- Programmangaben als kleine Tabelle: Beschriftung links, Wert rechts -->
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{loc:Text DetailsInstallLabel}" Margin="0,0,12,2" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding InstallInfo, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InstallInfo}" TextWrapping="Wrap" Margin="0,0,0,2"
                               Visibility="{Binding InstallInfo, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Grid.Row="1" Text="{loc:Text DetailsWingetIdLabel}" Margin="0,0,12,2" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding WingetId, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WingetId}" TextWrapping="Wrap" Margin="0,0,0,2"
                               Visibility="{Binding WingetId, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Grid.Row="2" Text="{loc:Text DetailsCpeLabel}" Margin="0,0,12,2" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding CpeText, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CpeText}" TextWrapping="Wrap" Margin="0,0,0,2"
                               Visibility="{Binding CpeText, Converter={StaticResource NullToVisibility}}" />
                </Grid>
                <!-- CPE: ohne Zuordnung „CPE zuordnen“; bei eigener Zuordnung ändern und „Vorschlag melden“ -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,8"
                            Visibility="{Binding CanMapCpe, Converter={StaticResource BoolToVisibility}}">
                    <ui:Button Content="{loc:Text DetailsMapCpe}" Icon="{ui:SymbolIcon Tag24}" Margin="0,0,8,0"
                               ToolTip="{loc:Text DetailsMapCpeTooltip}"
                               Command="{Binding DataContext.MapCpeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}" />
                    <ui:Button Content="{loc:Text DetailsReportCpe}" Icon="{ui:SymbolIcon Share24}"
                               ToolTip="{loc:Text DetailsReportCpeTooltip}"
                               Command="{Binding DataContext.ReportCpeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}"
                               Visibility="{Binding HasUserCpe, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Installationsordner: ermittelt das Modul erst beim Aufklappen, mit Herkunft oder Grund -->
                <StackPanel Margin="0,0,0,8" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding SelectedLocation.IsKnown, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                        <Run Text="{loc:Text DetailsFolderLabel}" /><Run Text="{Binding SelectedLocation.Path, Mode=OneWay}" />
                        <Run Text="{Binding SelectedLocation.Note, Mode=OneWay, StringFormat='({0})'}" />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding SelectedLocation.Reason, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}">
                        <Run Text="{loc:Text DetailsFolderUnknown}" /><Run Text="{Binding SelectedLocation.Reason, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                Visibility="{Binding SelectedLocation.IsKnown, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                        <ui:Button Content="{loc:Text DetailsOpenFolder}" Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,0,8,0"
                                   Command="{Binding OpenFolderCommand}"
                                   Visibility="{Binding SelectedLocation.CanOpen, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                        <ui:Button Content="{loc:Text DetailsCopyPath}" Icon="{ui:SymbolIcon Copy24}" Command="{Binding CopyPathCommand}" />
                    </StackPanel>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Refuted}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat='✓ {0}'}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Versionsverlauf: bisherige Aktionen zu diesem Programm aus dem Aktionsprotokoll -->
                <TextBlock Text="{loc:Text DetailsHistoryTitle}" FontWeight="SemiBold" Margin="0,8,0,0"
                           Visibility="{Binding DataContext.History.Count, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource CountToVisibility}}" />
                <ItemsControl ItemsSource="{Binding DataContext.History, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ActionHistoryEntry}">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" ToolTip="{Binding Message}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Werkzeugleiste -->
        <Grid Grid.Row="0" Margin="16,8,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MaxWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ui:Button Content="{loc:Text ProgramsScan}" Appearance="Primary"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           Command="{Binding ScanCommand}"
                           ToolTip="{loc:Text ProgramsScanTooltip}" />
                <!-- Schalter „Ohne Cache“: beim Einschalten Hinweis bzw. ohne NVD-Schlüssel Rückfrage mit Dauer -->
                <ui:ToggleSwitch Margin="12,0,0,0" VerticalAlignment="Center" Content="{loc:Text ProgramsScanWithoutCache}"
                                 IsChecked="{Binding ScanWithoutCache}" ToolTip="{loc:Text ProgramsScanWithoutCacheTooltip}" />
            </StackPanel>
            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="{loc:Text CommonCancel}"
                       Icon="{ui:SymbolIcon Dismiss24}"
                       Command="{Binding ScanCancelCommand}"
                       Visibility="{Binding ScanCommand.IsRunning, Converter={StaticResource BoolToVisibility}}" />
            <ui:TextBox Grid.Column="2" Margin="12,0,0,0"
                        PlaceholderText="{loc:Text ProgramsSearchPlaceholder}"
                        Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="{loc:Text ProgramsSearchName}" />
            <CheckBox Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center"
                      Content="{loc:Text ProgramsFilterUpdates}" IsChecked="{Binding ShowUpdatesOnly}" />
            <CheckBox Grid.Column="4" Margin="16,0,0,0" VerticalAlignment="Center"
                      Content="{loc:Text ProgramsFilterRisks}" IsChecked="{Binding ShowRisksOnly}"
                      ToolTip="{loc:Text ProgramsFilterRisksTooltip}" />
            <TextBlock Grid.Column="6" VerticalAlignment="Center" Text="{Binding CountText}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="16,0,16,0">
        <!-- Hinweis, solange „Ohne Cache“ an ist -->
        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                   Text="{loc:Text ScanWithoutCacheHint}"
                   Visibility="{Binding ScanWithoutCache, Converter={StaticResource BoolToVisibility}}" />

        <!-- Auswahl für die Update-Warteschlange (nur Updates; Deinstallieren bleibt einzeln) -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                    Visibility="{Binding ActionsAvailable, Converter={StaticResource BoolToVisibility}}">
            <ui:Button Content="{loc:Text QueueSelectAllWithUpdate}" Icon="{ui:SymbolIcon CheckboxChecked24}" Command="{Binding SelectAllWithUpdateCommand}" />
            <ui:Button Margin="8,0,0,0" Content="{loc:Text QueueClearSelection}" Command="{Binding ClearQueueSelectionCommand}" />
            <ui:Button Margin="8,0,0,0" Content="{loc:Text QueueUpdateSelected}" Appearance="Primary" Icon="{ui:SymbolIcon ArrowUpload24}"
                       Command="{Binding UpdateSelectedCommand}" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding QueueSelectionText}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Warteschlange: Status je Eintrag, Anhalten/Fortsetzen, Abbrechen -->
        <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="4" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Visibility="{Binding QueueEntries.Count, Converter={StaticResource CountToVisibility}}">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ui:Button Content="{loc:Text QueuePause}" Icon="{ui:SymbolIcon Pause24}" Command="{Binding PauseQueueCommand}"
                                   Visibility="{Binding QueueRunning, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Margin="8,0,0,0" Content="{loc:Text QueueResume}" Icon="{ui:SymbolIcon Play24}" Command="{Binding ResumeQueueCommand}"
                                   Visibility="{Binding QueuePaused, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Margin="8,0,0,0" Content="{loc:Text CommonCancel}" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding CancelQueueCommand}"
                                   Visibility="{Binding QueueRunning, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon Dismiss16}" ToolTip="{loc:Text NoticeDismiss}"
                                   AutomationProperties.Name="{loc:Text QueueDismissName}" Command="{Binding DismissQueueCommand}" />
                    </StackPanel>
                    <TextBlock FontWeight="SemiBold" VerticalAlignment="Center">
                        <Run Text="{loc:Text QueueTitle}" /><Run Text="{Binding QueueProgressText, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding QueueEntries}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:QueueEntryState}">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding StatusText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="16,0,0,2"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding Message, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <!-- Ergebnis der letzten Aktion -->
        <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="4" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Visibility="{Binding LastOutcome, Converter={StaticResource NullToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                        <Run Text="{Binding LastOutcome.ActionText, Mode=OneWay}" /><Run Text=" – " /><Run Text="{Binding LastOutcome.Name, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding LastOutcome.ResultText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding LastOutcome.Message}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding LastOutcome.Message, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Text="{Binding LastOutcome.RestorePointText}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <ui:Button Margin="0,0,12,0" Command="{Binding RetryWithNextMethodCommand}"
                                   Visibility="{Binding CanRetryWithNextMethod, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding LastOutcome.RetryText, Mode=OneWay}" />
                        </ui:Button>
                        <ui:HyperlinkButton Content="{loc:Text ActionVendorPage}" NavigateUri="{Binding LastOutcome.VendorUrl}" Padding="0" VerticalAlignment="Center"
                                            Visibility="{Binding LastOutcome.VendorUrl, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </StackPanel>
                <ui:Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top" Appearance="Transparent"
                           Icon="{ui:SymbolIcon Dismiss16}" ToolTip="{loc:Text CommonClose}" AutomationProperties.Name="{loc:Text ActionResultClose}"
                           Command="{Binding DismissOutcomeCommand}" />
            </Grid>
        </Border>

        <!-- Hinweise: winget fehlt, keine Quelle aktiviert, Fehler des Moduls -->
        <ItemsControl ItemsSource="{Binding Notices}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:Notice}">
                    <Border x:Name="Card" Margin="0,0,0,8" Padding="12,10" CornerRadius="4" BorderThickness="1"
                            Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon x:Name="Icon" Grid.Column="0" Symbol="Info24" Filled="True" FontSize="18"
                                           VerticalAlignment="Top" Margin="0,1,10,0"
                                           Foreground="{DynamicResource SystemFillColorAttentionBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <ui:Button Content="{Binding ActionText}" Command="{Binding Action}" Margin="0,0,12,0"
                                               Visibility="{Binding Action, Converter={StaticResource NullToVisibility}}" />
                                    <ui:HyperlinkButton Content="{Binding LinkText}" NavigateUri="{Binding Link}" Padding="0" VerticalAlignment="Center"
                                                        Visibility="{Binding Link, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                            </StackPanel>
                            <ui:Button Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Top" Appearance="Transparent"
                                       Icon="{ui:SymbolIcon Dismiss16}" ToolTip="{loc:Text NoticeDismiss}"
                                       AutomationProperties.Name="{loc:Text NoticeDismissName}"
                                       Command="{Binding DataContext.DismissNoticeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:NoticeSeverity.Warning}">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                            <Setter TargetName="Icon" Property="Symbol" Value="Warning24" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:NoticeSeverity.Error}">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                            <Setter TargetName="Icon" Property="Symbol" Value="ErrorCircle24" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </StackPanel>

        <!-- Hauptliste -->
        <Grid x:Name="ListHost" Grid.Row="2" Margin="16,0,16,8" SizeChanged="OnListHostSizeChanged">
            <DataGrid ItemsSource="{Binding ItemsView}"
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column"
                      CanUserReorderColumns="False"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      AutomationProperties.Name="{loc:Text ProgramsListName}"
                      PreviewMouseLeftButtonDown="OnGridPreviewMouseLeftButtonDown"
                      PreviewKeyDown="OnGridPreviewKeyDown">
                <DataGrid.Columns>
                    <!-- Häkchen für die Update-Warteschlange, nur bei verfügbarem Update -->
                    <DataGridTemplateColumn Width="56" MinWidth="56" CanUserSort="False" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:SoftwareItem}">
                                <CheckBox IsChecked="{Binding Queue.IsChecked, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UpdateAvailable}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center" MinWidth="0" Padding="0" Margin="12,0,0,0"
                                          AutomationProperties.Name="{loc:Text QueueCheckboxName}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{loc:Text ColumnRating}" SortMemberPath="Rating" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:SoftwareItem}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding ReasonText}">
                                    <!-- Ampelfarben aus dem Design (hell/dunkel), keine festen Werte; daneben steht immer der Text -->
                                    <Ellipse Width="12" Height="12">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorNeutralBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Rating}" Value="{x:Static models:Rating.Red}">
                                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Rating}" Value="{x:Static models:Rating.Yellow}">
                                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Rating}" Value="{x:Static models:Rating.Green}">
                                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Margin="6,0,0,0" Text="{Binding Rating, Converter={StaticResource RatingToText}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{loc:Text ColumnName}" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource TextCellWithTooltip}" />
                    <DataGridTextColumn Header="{loc:Text ColumnPublisher}" Binding="{Binding Publisher}" Width="*" ElementStyle="{StaticResource TextCellWithTooltip}" />
                    <DataGridTextColumn Header="{loc:Text ColumnInstalled}" Binding="{Binding InstalledVersion}" Width="140" ElementStyle="{StaticResource TextCellWithTooltip}" />
                    <DataGridTemplateColumn Header="{loc:Text ColumnLatest}" SortMemberPath="LatestVersion" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:SoftwareItem}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LatestVersion}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LatestVersion}" />
                                    <TextBlock Margin="4,0,0,0" Text="{loc:Text LatestUnconfirmed}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               ToolTip="{loc:Text LatestUnconfirmedTooltip}"
                                               Visibility="{Binding LatestVersionUnconfirmed, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{loc:Text ColumnVulnerabilities}" Binding="{Binding VulnerabilityText}" SortMemberPath="VulnerabilityCount" Width="110" ElementStyle="{StaticResource TextCellWithTooltip}" />
                    <DataGridTemplateColumn Header="{loc:Text ColumnReason}" SortMemberPath="ReasonSummary" Width="3*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:SoftwareItem}">
                                <TextBlock Text="{Binding ReasonSummary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           ToolTip="{Binding ReasonText}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- Geprüft: Alter der Online-Prüfung; veraltete Angaben (offline nur Zwischenspeicher) dezent kursiv -->
                    <DataGridTemplateColumn Header="{loc:Text ColumnChecked}" SortMemberPath="CheckedAt" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:SoftwareItem}">
                                <TextBlock Text="{Binding CheckedText}" ToolTip="{Binding CheckedTooltip}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CheckStale}" Value="True">
                                                    <Setter Property="FontStyle" Value="Italic" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{loc:Text ColumnSource}" Binding="{Binding Sources}" Width="140" ElementStyle="{StaticResource TextCellWithTooltip}" />
                </DataGrid.Columns>

            </DataGrid>

            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                       Text="{loc:Text ProgramsEmpty}" />
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding ShowNotScannedState, Converter={StaticResource BoolToVisibility}}"
                       Text="{loc:Text ProgramsNotScanned}" />

            <!-- Detailfeld: liegt rechts über der Liste, die Liste behält ihre volle Breite.
                 Breite am linken Rand verschiebbar (Anteil gemerkt in app-ui.json, mindestens 360 px). -->
            <!-- TextElement.Foreground: außerhalb des DataGrid erbt der Text sonst Schwarz statt der Textfarbe des Designs -->
            <Border x:Name="DetailsPanel" HorizontalAlignment="Right" CornerRadius="8,0,0,8"
                    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="{Binding IsDetailsOpen, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{loc:Text DetailsPanelName}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="180" Opacity="0.25" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Thumb Grid.Column="0" Cursor="SizeWE" Background="Transparent" ToolTip="{loc:Text DetailsResizeTooltip}"
                           DragDelta="OnDetailsResizeDelta" DragCompleted="OnDetailsResizeCompleted">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="Transparent" />
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    <DockPanel Grid.Column="1" Margin="10,10,4,0">
                        <!-- Kopf: Programm und Schließen -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,8,8">
                            <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent" Padding="6"
                                       ToolTip="{loc:Text DetailsCloseTooltip}" AutomationProperties.Name="{loc:Text CommonClose}"
                                       Command="{Binding CloseDetailsCommand}" />
                            <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding SelectedItem.Name, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding SelectedItem.InstalledVersion, Mode=OneWay}"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="Normal" />
                            </TextBlock>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                            <ContentControl Content="{Binding SelectedItem}" ContentTemplate="{StaticResource ProgramDetailsTemplate}" Focusable="False" />
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Statuszeile -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="16,0,16,10">
            <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" Margin="0,0,8,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
